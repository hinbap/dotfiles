# ─────────────────────────────────────────────
# Zathura — monoglow
# ─────────────────────────────────────────────

# General
set selection-clipboard clipboard
set guioptions ""
set window-title-page true
set window-opacity 0.5

# Page layout
set adjust-open "best-fit"
set pages-per-row 1
set scroll-page-aware true
set scroll-full-overlap 0.01
set scroll-step 100

# Zoom
set zoom-min 10

# ─────────────────────────────────────────────
# Colors (monoglow Z, bg matched to Ghostty #000000)
# ─────────────────────────────────────────────

# UI
set default-bg "#000000"
set default-fg "#cccccc"

set statusbar-bg "#121212"
set statusbar-fg "#cccccc"

set inputbar-bg "#121212"
set inputbar-fg "#cccccc"

# Notifications
set notification-bg "#121212"
set notification-fg "#cccccc"

set notification-error-bg "#121212"
set notification-error-fg "#ffc0b9"

set notification-warning-bg "#121212"
set notification-warning-fg "#fce094"

# Completion menu
set completion-bg "#121212"
set completion-fg "#cccccc"
set completion-highlight-bg "#1bfd9c"
set completion-highlight-fg "#000000"

# Search / highlights
set highlight-color "#66b2b2"
set highlight-active-color "#1bfd9c"

# ─────────────────────────────────────────────
# PDF appearance (dark, matching the terminal)
# ─────────────────────────────────────────────

# Dark mode for PDFs
set recolor true
set recolor-lightcolor "#000000"
set recolor-darkcolor "#cccccc"

# Preserve colors in diagrams/images
set recolor-keephue true
set recolor-reverse-video true

# ─────────────────────────────────────────────
# Keybindings
# ─────────────────────────────────────────────

map f toggle_fullscreen
